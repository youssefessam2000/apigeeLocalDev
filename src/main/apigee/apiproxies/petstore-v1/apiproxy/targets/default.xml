<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<TargetEndpoint name="default">
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>AM-PetstoreRequest</Name>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <Flows/>
  <PostFlow name="PostFlow">
    <Request/>
    <Response>
      <Step>
        <Name>EV-ExtractPet</Name>
      </Step>
      <Step>
        <Name>JS-MapPet</Name>
      </Step>
      <Step>
        <Name>FC-BuildSuccess</Name>
      </Step>
    </Response>
  </PostFlow>
  <!-- Backend errors (404, 5xx) and timeouts are raised here; same handler as the proxy endpoint. -->
  <DefaultFaultRule name="default-fault">
    <Step>
      <Name>FC-BuildError</Name>
      <Condition>envelope.errorHandled != "true"</Condition>
    </Step>
    <AlwaysEnforce>true</AlwaysEnforce>
  </DefaultFaultRule>
  <HTTPTargetConnection>
    <Properties>
      <Property name="connect.timeout.millis">3000</Property>
      <Property name="io.timeout.millis">10000</Property>
    </Properties>
    <SSLInfo>
      <Enabled>true</Enabled>
      <Enforce>true</Enforce>
    </SSLInfo>
    <URL>https://petstore.swagger.io/v2</URL>
  </HTTPTargetConnection>
</TargetEndpoint>
