<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Same key the oauth2-token proxy signs with; it lives in the environment KVM, not in Git. -->
<KeyValueMapOperations continueOnError="false" enabled="true" name="KVM-GetSigningKey" mapIdentifier="oauth-config">
  <DisplayName>KVM-GetSigningKey</DisplayName>
  <ExpiryTimeInSecs>300</ExpiryTimeInSecs>
  <Get assignTo="private.secretkey">
    <Key>
      <Parameter>jwt-signing-key</Parameter>
    </Key>
  </Get>
  <Scope>environment</Scope>
</KeyValueMapOperations>
