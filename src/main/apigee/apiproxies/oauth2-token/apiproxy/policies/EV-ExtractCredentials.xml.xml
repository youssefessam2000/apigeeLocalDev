<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ExtractVariables continueOnError="false" enabled="true" name="EV-ExtractCredentials">
  <DisplayName>EV-ExtractCredentials</DisplayName>
  <Source clearPayload="false">request</Source>
  <FormParam name="grant_type">
    <Pattern ignoreCase="true">{requested_grant_type}</Pattern>
  </FormParam>
  <FormParam name="client_id">
    <Pattern ignoreCase="true">{requested_client_id}</Pattern>
  </FormParam>
  <FormParam name="client_secret">
    <Pattern ignoreCase="true">{requested_client_secret}</Pattern>
  </FormParam>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</ExtractVariables>